# Template for a Wazuh Indexer/OpenSearch connection.
# The CLI does not read this file automatically. Export these values in
# your shell, load them through a secret manager, or pass this file to a
# container with Docker's explicit --env-file option.

WAZUH_OS_HOST=https://indexer:9200
WAZUH_OS_USER=triage-readonly
WAZUH_OS_PASSWORD=
WAZUH_OS_VERIFY_TLS=true

# Use a dedicated read-only Indexer account. Keep certificate verification
# enabled outside an isolated disposable lab, and never commit a populated
# .env file.
