# OpenSearch / Wazuh Indexer connection.
# This file is a template; the CLI does not load it automatically.
WAZUH_OS_HOST=https://indexer:9200
# Use a dedicated account with read access to the required indices.
WAZUH_OS_USER=triage-readonly
# Set this in the process environment or a secret manager before a live run.
WAZUH_OS_PASSWORD=
# Keep certificate verification enabled outside an isolated disposable lab.
WAZUH_OS_VERIFY_TLS=true
